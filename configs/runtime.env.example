# Shared, scheduler-neutral runtime configuration.
# Copy to a private file and source it before creating or running task plans.

NCP_OLMO_EVAL_ROOT=/shared/ncp-olmo-eval/results
NCP_OLMO_EVAL_CACHE=/shared/ncp-olmo-eval/cache
NCP_OLMO_CORE88_DATA_ROOT=/shared/ncp-olmo-eval/data/core88
NCP_OLMO_PREPARED_DATA_ROOT=/shared/ncp-olmo-eval/data/prepared
NCP_OLMO_GSM8K_PROMPT=/shared/ncp-olmo-eval/data/gsm8k/standard_input.json
NCP_OLMO_GSM8K_TASK_INCLUDE=/shared/ncp-olmo-eval/data/gsm8k/tasks
NCP_OLMO_GSM8K_TEST_FILE=/shared/ncp-olmo-eval/data/gsm8k/test.parquet
NCP_OLMO_HELMET_SOURCE_ROOT=/shared/ncp-olmo-eval/sources/HELMET
NCP_OLMO_OLMO_EVAL_ROOT=/shared/ncp-olmo-eval/sources/OLMo-Eval
NCP_OLMO_CORE88_ANSWER_SCORER_ROOT=/shared/ncp-olmo-eval/runtime/core88-answer

# Image references are hints stored in task.json. Site adapters decide how to
# pull and run them. Always use immutable digests for formal evaluation.
NCP_OLMO_EVAL_IMAGE=ghcr.io/your-org/ncp-olmo-eval@sha256:REPLACE_ME
CORE88_PYTHON_IMAGE=ghcr.io/your-org/core88-python@sha256:REPLACE_ME
CORE88_BIGCODEBENCH_IMAGE=ghcr.io/your-org/core88-bigcodebench@sha256:REPLACE_ME
CORE88_DS1000_IMAGE=ghcr.io/your-org/core88-ds1000@sha256:REPLACE_ME
CORE88_MULTIPLE_IMAGE=ghcr.io/your-org/core88-multiple@sha256:REPLACE_ME

# All formal tasks are offline. Run `ncp-olmo-eval-assets prepare` first.
HF_HOME=/shared/ncp-olmo-eval/cache/huggingface
HF_HUB_CACHE=/shared/ncp-olmo-eval/cache/huggingface/hub
HF_DATASETS_CACHE=/shared/ncp-olmo-eval/cache/huggingface/datasets
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
NLTK_DATA=/shared/ncp-olmo-eval/cache/nltk
HELMET_AUTOAIS_MODEL=/shared/ncp-olmo-eval/assets/helmet-autoais
